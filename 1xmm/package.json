{
  "name": "clicker-game",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview --host 0.0.0.0",
    "deploy:dev": "git pull origin develop_fb --no-edit  && cp .env.production .env && docker-compose -f docker-compose.pro.yml build && docker-compose -f docker-compose.pro.yml up -d",
    "deploy:main": "git pull origin main --no-edit  && cp .env.main .env && docker-compose -f docker-compose.main.yml build && docker-compose -f docker-compose.main.yml up -d"
  },
