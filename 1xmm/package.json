    "@radix-ui/react-slot": "^1.1.1",
    "@tanstack/react-query": "^5.62.16",
    "@ton/core": "^0.59.1",
    "@tonconnect/sdk": "^3.0.5",
    "@tonconnect/ui": "^2.0.9",
    "@tonconnect/ui-react": "^2.0.9",
    "@uidotdev/usehooks": "^2.4.1",
    "async": "^2.6.4",
