{
  "name": "clicker-game",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview --host 0.0.0.0",
    "deploy:dev": "git pull origin develop --no-edit  && cp .env.production .env && docker-compose -f docker-compose.pro.yml build && docker-compose -f docker-compose.pro.yml up -d",
    "deploy:main": "git pull origin main --no-edit  && cp .env.main .env && docker-compose -f docker-compose.main.yml build && docker-compose -f docker-compose.main.yml up -d"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@tanstack/react-query": "^5.47.0",
    "@ton/core": "^0.59.0",
    "@tonconnect/sdk": "^3.0.5",
    "@tonconnect/ui": "^2.0.9",
    "@tonconnect/ui-react": "^2.0.9",
    "@uidotdev/usehooks": "^2.4.1",
    "async": "^2.6.4",
    "async-parallel-foreach": "^1.0.1",
    "axios": "^1.7.2",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.11",
    "decimal.js": "^10.4.3",
    "electron-to-chromium": "^1.5.62",
    "express": "^4.21.2",
    "lucide-react": "^0.395.0",
    "pusher-js": "^8.4.0-rc2",
    "react": "^18.3.1",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.23.1",
    "react-toastify": "^10.0.5",
    "socket.io-client": "^4.8.0",
    "styled-components": "^6.1.13",
    "swiper": "^11.1.4",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "^5.47.0",
    "@types/decimal.js": "^7.4.3",
    "@types/express": "^5.0.0",
    "@types/node": "^20.14.6",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/telegram-web-app": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "husky": "^9.1.6",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "telegram-webapps-types": "^1.0.5",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}
